{
  "css.enabledLanguages": ["html", "blade", "vue", "astro"],
  "css.styleSheets": [
    "**/*.{css,scss}",
    "**/node_modules/bootstrap/dist/css/bootstrap.css",
    "**/node_modules/tailwindcss/**/*.css"
  ],
  "tailwindCSS.includeLanguages": {
    "blade": "html",
    "astro": "html",
    "vue": "html"
  },
  "tailwindCSS.emmetCompletions": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "eslint.validate": [
    "javascript",
    "javascriptreact",
    "typescript",
    "typescriptreact",
    "vue"
  ],
  "typescript.tsdk": "",
  "intelephense.files.maxSize": 5000000,
  "intelephense.environment.phpVersion": "8.3",
  "files.associations": {
    "*.blade.php": "blade"
  },
  "emmet.includeLanguages": {
    "blade": "html",
    "astro": "html"
  },
  "editor.suggestSelection": "first",
  "editor.snippetSuggestions": "top",
  "editor.fontFamily": "'Cascadia Code NF', 'Cascadia Code', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.lineHeight": 26,
  "editor.letterSpacing": 0.3,
  "editor.fontWeight": "normal",
  "terminal.integrated.fontFamily": "'Cascadia Code NF', monospace",
  "terminal.integrated.fontSize": 15,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.colorTheme": "Dracula Theme",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.cursorStyle": "line",
  "editor.cursorWidth": 2,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.minimap.enabled": true,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.showSlider": "mouseover",
  "editor.renderWhitespace": "selection",
  "editor.wordWrap": "off",
  "editor.tabSize": 2,
  "editor.detectIndentation": true,
  "editor.autoClosingBrackets": "always",
  "editor.linkedEditing": true,
  "editor.smoothScrolling": true,
  "editor.scrollBeyondLastLine": false,
  "editor.renderLineHighlight": "all",
  "editor.stickyScroll.enabled": true,
  "editor.gotoLocation.multiple": "peek",
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.trimAutoWhitespace": true,
  "editor.showFoldingControls": "always",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.inlineSuggest.enabled": true,
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/vendor": true,
    "**/.DS_Store": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/vendor": true,
    "**/.git": true
  },
  "explorer.confirmDelete": false,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "breadcrumbs.enabled": true,
  "breadcrumbs.symbolPath": "on",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 18,
  "workbench.editor.enablePreview": false,
  "workbench.editor.wrapTabs": true,
  "workbench.list.smoothScrolling": true,
  "window.zoomLevel": 0,
  "window.titleBarStyle": "custom",
  "window.commandCenter": true,
  "window.autoDetectColorScheme": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "[php]": {
    "editor.defaultFormatter": "bmewburn.vscode-intelephense-client"
  },
  "[blade]": {
    "editor.defaultFormatter": "shufo.vscode-blade-formatter"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "python.terminal.activateEnvironment": false,
  "python.testing.pytestEnabled": true,
  "python.analysis.typeCheckingMode": "basic",
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],
  "errorLens.messageEnabled": true,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.addVerticalPadding": false,
  "todo-tree.highlights.enabled": true,
  "todo-tree.general.showActivityBarBadge": true,
  "todo-tree.ripgrep": "/home/linuxbrew/.linuxbrew/bin/rg",
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "foreground": "#C77A3C",
          "fontStyle": "italic"
        }
      }
    ]
  },
  "cSpell.language": "es,en",
  "cSpell.diagnosticLevel": "Warning",
  "cSpell.enableFiletypes": ["markdown", "plaintext", "php", "javascript", "typescript", "vue", "astro"],
  "editor.hover.enabled": true,
  "editor.hover.delay": 300,
  "editor.hover.above": false,
  "editor.parameterHints.enabled": true,
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "on",
    "strings": "on"
  },
  "editor.renderLineHighlight": "all",
  "editor.occurrencesHighlight": "singleFile",
  "workbench.colorCustomizations": {
    "editor.lineHighlightBackground": "#1A2A2A",
    "editor.lineHighlightBorder": "#3A4A4A",
    "editor.selectionBackground": "#264F78",
    "editor.inactiveSelectionBackground": "#1E4660",
    "editor.findMatchBackground": "#5B3A00",
    "editor.findMatchHighlightBackground": "#3A2A00",
    "editorCursor.foreground": "#F8F8F2"
  }
}
