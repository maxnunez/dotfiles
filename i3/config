# ─── i3 Config ──────────────────────────────────────
# DankLinux Material Design 3 Theme
# Mod = Super (Windows key)

# ─── Tecla mod ──────────────────────────────────────
set $mod Mod4

# ─── Font (REQUERIDO) ───────────────────────────────
font pango:Inter 10

# ─── Mouse ─────────────────────────────────────────
focus_follows_mouse no
focus_on_window_activation smart
workspace_auto_back_and_forth yes
title_align center

# ─── Terminal ───────────────────────────────────────
set $term kitty
bindsym $mod+Return exec $term
for_window [instance="kitty"] title_format "⌨ terminal"

# ─── Rofi: app launcher, window switcher, commands ──
bindsym $mod+d exec rofi -show drun
bindsym $mod+Shift+d exec rofi -show run
bindsym $mod+Shift+w exec rofi -show window

# ─── Cerrar / salir ─────────────────────────────────
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m '¿Salir de i3?' -B 'Sí' 'i3-msg exit' -B 'Apagar' 'systemctl poweroff' -B 'Reiniciar' 'systemctl reboot'"

# ─── Navegación entre ventanas (hjkl como vim) ─────
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# ─── Mover ventanas (Shift + hjkl) ──────────────────
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# ─── Split (como Zellij) ────────────────────────────
bindsym $mod+v split vertical
bindsym $mod+b split horizontal
bindsym $mod+f fullscreen toggle

# ─── Layout ─────────────────────────────────────────
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# ─── Pantalla flotante / redimensionar ──────────────
floating_modifier $mod
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+s sticky toggle

# ─── Scratchpad mejorado ───────────────────────────
bindsym $mod+minus move scratchpad
bindsym $mod+Shift+minus scratchpad show
bindsym $mod+apostrophe scratchpad show

# ─── Scratchpad terminal (slide down) ──────────────
for_window [instance="scratchpad-term"] move scratchpad, floating enable, resize set 1200 700, move position center
bindsym $mod+grave exec --no-startup-id bash -c "$term --class scratchpad-term & sleep 0.2; i3-msg '[instance=scratchpad-term] scratchpad show'"

# ─── Mover ventana a workspace y seguirlo ───────────
bindsym $mod+Shift+BackSpace move workspace to output left; workspace prev

# ─── Mover workspace a otro monitor con flechas ─────
bindsym $mod+Shift+Right move workspace to output right
bindsym $mod+Shift+Left move workspace to output left

# ─── Segunda pantalla (HDMI1) ────────────────────────
# Super+Shift+M : toggle pantalla externa extendida / solo notebook
bindsym $mod+Shift+m exec --no-startup-id ~/.local/bin/monitor-extended toggle

# ─── Redimensionar ─────────────────────────────────
mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# ─── Workspaces ─────────────────────────────────────
set $ws1 "casa"
set $ws2 "web"
set $ws3 "term"
set $ws4 "docs"
set $ws5 "media"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Ctrl+Left  workspace prev
bindsym $mod+Ctrl+Right workspace next

bindsym $mod+a focus parent
bindsym $mod+z focus child

# ─── Apps rápidas ───────────────────────────────────
bindsym $mod+Shift+f exec firefox
bindsym $mod+Shift+n exec nvim
bindsym $mod+Shift+t exec --no-startup-id kitty -e yazi
bindsym $mod+Ctrl+Shift+t exec thunar
bindsym $mod+Shift+i exec --no-startup-id /home/max/.local/bin/scratchpad-toggle obsidian flatpak run md.obsidian.Obsidian
bindsym $mod+Shift+p exec flatpak run io.github.diegopvlk.Tomatillo

# ─── Pizarra (gromit-mpx) ────────────────────────────
exec_always --no-startup-id gromit-mpx --active --key none
bindsym $mod+Mod1+p exec ~/.local/bin/gromit-toggle
bindsym $mod+Ctrl+b exec gromit-mpx --clear
bindsym $mod+Shift+a exec flatpak run org.gnome.clocks

# ─── Descompresión rápida ──────────────────────────
bindsym $mod+g exec /home/max/.local/bin/extract-rofi

# ─── Multimedia ─────────────────────────────────────
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle
bindsym XF86AudioPlay exec --no-startup-id playerctl play-pause
bindsym XF86AudioNext exec --no-startup-id playerctl next
bindsym XF86AudioPrev exec --no-startup-id playerctl previous
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

bindsym $mod+Up exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +5%
bindsym $mod+Down exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -5%
bindsym $mod+m exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle

bindsym $mod+Shift+Up exec --no-startup-id brightnessctl set +5%
bindsym $mod+Shift+Down exec --no-startup-id brightnessctl set 5%-

bindsym $mod+Ctrl+space exec --no-startup-id playerctl play-pause
bindsym $mod+comma exec --no-startup-id playerctl previous
bindsym $mod+period exec --no-startup-id playerctl next

# ─── Apps a workspaces ──────────────────────────────
assign [class="firefox"] $ws2
assign [class="Thunar"] $ws4
assign [class="obsidian"] $ws4
assign [title="yazi"] $ws4

# ─── Telegram: cerrar modales con Escape ────────────
bindsym $mod+Escape exec --no-startup-id ~/.local/bin/telegram-escape.sh
for_window [class="Telegram"] focus on_window_activation smart
for_window [class="Telegram" title=".*"] floating enable

# ─── Ventanas flotantes ─────────────────────────────
for_window [floating] move position center
for_window [class="(?i)Vlc"] floating enable
for_window [class="(?i)mpv"] floating enable
for_window [class="(?i)Galculator"] floating enable
for_window [title="Administrador de archivos"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable
for_window [class="(?i)firefox" window_role="About"] floating enable
for_window [class="(?i)Tomatillo"] floating enable
for_window [class="(?i)Gnome-clocks"] floating enable
for_window [class="(?i)Zathura"] floating enable
for_window [title="yazi"] floating enable, resize set 1000 700, move position center

show_marks no

# ─── Apariencia — DankLinux Material Design 3 ───────
# Deep dark background with teal primary accent
set $bg         #0D1117
set $bg_alt     #161B22
set $surface    #21262D
set $fg         #E6EDF3
set $fg_dim     #8B949E
set $primary    #00B899
set $secondary  #A78BFA
set $red        #FF7B72
set $green      #7EE787
set $yellow     #E3B341
set $blue       #79C0FF
set $cyan       #56D4DD
set $magenta    #D2A8FF

client.focused          $primary    $primary    $bg      #000000  $primary
client.focused_inactive $bg_alt     $bg_alt     $fg_dim  $bg_alt  $bg_alt
client.unfocused        $surface    $surface    $fg_dim  $surface $surface
client.urgent           $red        $red        $bg      $red     $red
client.placeholder      $surface    $surface    $fg_dim  $surface $surface

# ─── Bordes y gaps ───────────────────────────────
new_window pixel 2
new_float normal
smart_borders on
smart_gaps on

gaps inner 10
gaps outer 4

# ─── Urgent workspace: focus al hacer popup ──────
popup_during_fullscreen smart

bindsym $mod+Ctrl+plus  gaps inner current plus 5
bindsym $mod+Ctrl+minus gaps inner current minus 5

# ─── Gaps toggle ──────────────────────────────────────
bindsym $mod+Ctrl+g gaps inner current set 0; gaps outer current set 0
bindsym $mod+Ctrl+Shift+g gaps inner current set 10; gaps outer current set 4

# ─── Barra de estado (Polybar) ─────────────────────
exec_always --no-startup-id ~/.config/polybar/launch.sh

# ─── Fondo de pantalla ─────────────────────────────
exec --no-startup-id feh --bg-fill ~/Pictures/wallpapers/backiee-286513-landscape.jpg
exec --no-startup-id ln -sf ~/Pictures/wallpapers/backiee-286513-landscape.jpg /tmp/current-wallpaper
exec --no-startup-id bash -c "echo ~/Pictures/wallpapers/backiee-286513-landscape.jpg > /tmp/current-wallpaper-path"
bindsym $mod+Shift+b exec --no-startup-id /home/max/.local/bin/wallpaper-select
bindsym $mod+bracketright exec --no-startup-id /home/max/.local/bin/wallpaper-cycle next
bindsym $mod+bracketleft exec --no-startup-id /home/max/.local/bin/wallpaper-cycle prev
bindsym $mod+backslash exec --no-startup-id /home/max/.local/bin/wallpaper-cycle rand

# ─── Arrancar apps al inicio ───────────────────────
exec --no-startup-id xfce4-power-manager
exec --no-startup-id nm-applet
exec --no-startup-id volumeicon

# ─── Teclado US por defecto ───────────────────────
exec_always --no-startup-id setxkbmap us
bindsym $mod+Shift+u exec setxkbmap us
bindsym $mod+Shift+y exec setxkbmap es

# ─── Compositor ────────────────────────────────────
exec_always --no-startup-id picom --config ~/.config/picom/picom.conf

# ─── Notificaciones (dunst) ────────────────────────
exec --no-startup-id dunst

# ─── Auto-mount discos (udiskie) ────────────────────
exec_always --no-startup-id bash -c 'nohup udiskie > /dev/null 2>&1 &'

# ─── Screenshots (flameshot) ───────────────────────
bindsym $mod+Shift+z exec --no-startup-id flameshot gui
bindsym $mod+Mod1+z exec --no-startup-id zathura
bindsym $mod+Shift+x exec --no-startup-id flameshot full -p ~/Pictures

# ─── Portapapeles (copyq + rofi history) ──────────
exec --no-startup-id copyq
bindsym $mod+Ctrl+v exec --no-startup-id copyq show
bindsym $mod+Ctrl+Shift+v exec --no-startup-id bash -c 'copyq read all 2>/dev/null | rofi -dmenu -p "Historial" -i | head -1 | xargs -r -I{} sh -c "echo {} | copyq select"'

# ─── Bloqueo de pantalla ──────────────────────────
exec --no-startup-id xss-lock -- /home/max/.local/bin/lock-screen
bindsym $mod+Shift+o exec --no-startup-id /home/max/.local/bin/lock-screen

# ─── Control de volumen gráfico ───────────────────
bindsym $mod+Ctrl+m exec --no-startup-id pavucontrol

# ─── Limpiar notificaciones pegadas ──────────────
bindsym $mod+n exec --no-startup-id /home/max/.local/bin/dunst-restart

# ─── Seleccionar red ───────────────────────────────
bindsym $mod+Ctrl+n exec --no-startup-id $term -e nmtui-connect
